# Keep text files consistent across Windows and Unix development machines.
* text=auto eol=lf

# Preserve native line endings for Windows scripts if added later.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must not be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.dll binary
*.node binary
*.sqlite binary
*.sqlite3 binary
*.db binary
